# ==============================================================================
# StatSkill AI - Backend Environment Variables
# SIH PS 26101 - Zero Cost Free-Tier Deployment Configuration
# ==============================================================================

# Application
APP_NAME="StatSkill AI Backend"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"
PORT=8000

# CORS Configuration (comma-separated origins)
# For local dev: http://localhost:5173,http://127.0.0.1:5173
# For Vercel production: https://your-statskill-frontend.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (Supabase PostgreSQL, Local Docker PostgreSQL, or Local SQLite)
# 1. Supabase Production (Free Tier) - Replace [YOUR-PASSWORD]:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.vupdeaqxftanhturjrrq.supabase.co:5432/postgres
# 2. Local Docker with pgvector:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/statskill
# 3. Local Lightweight SQLite (Zero Docker required for quick bare-metal testing):
# DATABASE_URL=sqlite+aiosqlite:///./statskill.db

# JWT Authentication (Self-Rolled, Zero Paid Vendor)
# Generate a secure key locally using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=supersecret_statskill_jwt_key_hackathon_demo_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Generous Free Tiers)
# Google Gemini API Free Tier (gemini-1.5-flash / gemini-2.0-flash)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# Groq Cloud Free Tier (Llama 3 hosted ultra-fast inference)
# Get from: https://console.groq.com/
GROQ_API_KEY=

# Supabase Storage & Vector Config (Free Tier 1GB Storage + 500MB DB)
# Get from: https://supabase.com/dashboard/project/[ref]/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
